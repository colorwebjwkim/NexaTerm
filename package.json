{
  "name": "nexaterm",
  "version": "0.3.3",
  "private": true,
  "description": "통합 원격 터미널 및 SFTP 클라이언트",
  "author": "NexaTerm",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "start": "powershell -NoProfile -Command \"& ./src-tauri/target/release/nexaterm.exe\"",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "test:release": "node scripts/smoke-release.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "pnpm typecheck && vite build",
    "build": "tauri build --no-bundle",
    "dist:win": "tauri build --bundles nsis",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "ssh2": "1.17.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
